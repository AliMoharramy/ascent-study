# Caddy terminates TLS (automatic Let's Encrypt for a real DOMAIN; internal cert for localhost).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# brute-force protection lives in the app (5 attempts → 15 min lock)
	reverse_proxy app:3000 {
		health_uri /healthz
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}
