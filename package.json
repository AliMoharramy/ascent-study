{
  "name": "the-ascent",
  "version": "0.1.0",
  "private": true,
  "description": "THE ASCENT — a self-hosted, gamified study + habit engine for exam preparation",
  "license": "MIT",
  "author": "Ali Moharrami",
  "homepage": "https://github.com/AliMoharramy/ascent-study#readme",
  "repository": { "type": "git", "url": "git+https://github.com/AliMoharramy/ascent-study.git" },
  "bugs": { "url": "https://github.com/AliMoharramy/ascent-study/issues" },
  "keywords": ["study", "exam-prep", "habit-tracker", "gamification", "spaced-repetition", "nextjs", "postgresql", "self-hosted"],
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@vercel/oidc": "4.0.9",
    "postcss": "8.5.23"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "user:ensure": "tsx scripts/ensure-dev-user.ts",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "seed:validate": "tsx scripts/validate-seed.ts",
    "art:validate": "tsx scripts/validate-art.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "offsite": "tsx scripts/offsite.ts",
    "replay": "tsx scripts/replay.ts",
    "telegram:bot": "tsx scripts/telegram-bot.ts",
    "icons:gen": "node scripts/gen-icons.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "visual": "node scripts/visual-regression.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@types/pg": "^8.23.1",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.3",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "node-cron": "4.2.1",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "ulid": "3.0.1",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.18.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.29",
    "fast-check": "4.3.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "puppeteer-core": "24.31.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "5.1.1"
  }
}
