# Examples only. Never commit real credentials or paste them into chat.
# Production values belong only in the Vercel "Production" environment, never Preview or Development.

# Runtime: the POOLED connection string of the managed PostgreSQL (verified TLS is required for remote hosts).
DATABASE_URL=
# Operators/CI only (db:migrate, restore, dumps): the DIRECT (non-pooler) connection string. Never set it on Vercel Runtime.
DIRECT_DATABASE_URL=
# Disposable local/CI PostgreSQL only; never production. Must differ from DATABASE_URL.
TEST_DATABASE_URL=
# Explicit restore target (use an empty scratch database for restore drills).
RESTORE_DATABASE_URL=
# Connections per instance (1-10, default 4).
DB_POOL_MAX=4

TZ=Asia/Tehran
# No background jobs by default. Vercel cron uses authenticated API routes.
DISABLE_JOBS=true

# Local/Docker backup folders only. Vercel disk is ephemeral and is never used for backups.
BACKUP_DIR=./data/backups
OFFSITE_DIR=./data/offsite
# AES-256-GCM passphrase or 64 hex characters. REQUIRED for the nightly backup on Vercel (stored encrypted in a
# private Blob store). Keep it separate from the backups: without it they cannot be restored.
OFFSITE_KEY=

# Optional AI services can incur costs independent of the database.
AI_BASE_URL=
AI_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
TELEGRAM_BOT_TOKEN=
# Optional separate key for time capsules; keep it separately from backups.
CAPSULE_KEY=
# Guards /api/cron/* (Vercel sends it as a Bearer token).
CRON_SECRET=
# Strongly recommended on ANY internet-reachable deployment: a long random string. Creating the one and only account then
# also requires this value, so a stranger who finds the URL before you cannot claim the server. Leave empty on localhost.
SETUP_TOKEN=
