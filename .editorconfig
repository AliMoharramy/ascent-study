# https://editorconfig.org — keeps editors consistent across Windows, macOS and Linux
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.slint]
indent_size = 4
